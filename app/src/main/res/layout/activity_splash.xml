<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8ED">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">


        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_tobacco_leaf"
            android:contentDescription="Logo Daun Tembakau"
            android:layout_marginBottom="20dp"
            android:scaleType="fitCenter"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Isnu Tobacco"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#321B0C"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kelola Stok, Lebih Mudah"
            android:textSize="16sp"
            android:textColor="#704522"
            android:layout_marginTop="8dp"/>

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="50dp"
            android:indeterminateTint="#704020"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memuat aplikasi..."
            android:textSize="14sp"
            android:textColor="#704522"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</RelativeLayout>
