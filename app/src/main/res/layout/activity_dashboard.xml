<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8ED"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#704020"
            android:padding="18dp"
            android:layout_marginBottom="25dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISNU TOBACCO"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat datang, Admin!"
                    android:textColor="#F5DFC2"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Keluar"
                android:textSize="12sp"
                android:textColor="#704020"
                android:backgroundTint="#FFF8ED"/>

        </LinearLayout>

        <!-- JUDUL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ringkasan Stok Barang"
            android:textColor="#321B0C"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp"/>

        <!-- KARTU BARIS 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- TOTAL BARANG -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦"
                    android:textSize="27sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Barang"
                    android:textColor="#704522"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvTotalBarang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#321B0C"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- STOK MASUK -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬆️"
                    android:textSize="27sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stok Masuk"
                    android:textColor="#704522"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvStokMasuk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#23823A"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- JARAK -->
        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"/>

        <!-- KARTU BARIS 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- STOK KELUAR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬇️"
                    android:textSize="27sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stok Keluar"
                    android:textColor="#704522"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvStokKeluar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#D94A35"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- STOK MENIPIS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="27sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stok Menipis"
                    android:textColor="#704522"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvStokMenipis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#D99518"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- MENU PENGELOLAAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu Pengelolaan"
            android:textColor="#321B0C"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnDataBarang"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Data Barang"
            android:textColor="#FFFFFF"
            android:backgroundTint="#704020"/>

        <Button
            android:id="@+id/btnStokMasuk"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Stok Masuk"
            android:textColor="#FFFFFF"
            android:backgroundTint="#704020"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnStokKeluar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Stok Keluar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#704020"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnLaporan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Laporan Stok"
            android:textColor="#FFFFFF"
            android:backgroundTint="#704020"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
